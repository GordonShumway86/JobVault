# Copy this file to .env.local and fill in your Supabase project details.
# Get these from https://supabase.com/dashboard -> your project -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# This app has no login screen — it signs itself in automatically using one
# fixed account, so there's nothing to type and nothing to get locked out
# of. Pick any email (it doesn't need to be real/reachable) and a strong
# random password, create that one account in Supabase (Authentication ->
# Users -> Add user, with "Auto Confirm User" checked), then put the same
# values here.
VITE_APP_EMAIL=owner@example.com
VITE_APP_PASSWORD=a-long-random-password

# Since this app is a public website, anyone with the URL could otherwise
# open it and it would just... sign them in (that's what the auto-login
# above does). This PIN screen is the actual gate. It's a SHA-256 hash of
# your chosen PIN, not the PIN itself — compute it with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PIN').digest('hex'))"
VITE_APP_PIN_HASH=hash-of-your-pin-goes-here
